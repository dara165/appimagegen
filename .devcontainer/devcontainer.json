{
  "name": "Codespace Agentic Hub (OpenCode, Paseo, ttyd)",
  "forwardPorts": [4096, 6767, 7681],
  "portsAttributes": {
    "4096": {
      "label": "OpenCode Web UI",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "7681": {
      "label": "ttyd Web Terminal",
      "onAutoForward": "ignore",
      "visibility": "public"
    },
    "6767": {
      "label": "Paseo Web UI",
      "onAutoForward": "ignore",
      "visibility": "public"
    }
  },
  "postStartCommand": "sudo /usr/local/bin/codespace-supervisor.sh --check-once"
}
